{
  "name": "northwind-ai-agent-workspace",
  "private": true,
  "version": "1.0.0",
  "description": "Northwind — AI Agent Workspace admin dashboard template (React, TypeScript, Tailwind CSS).",
  "type": "module",
  "license": "SEE LICENSE IN LICENSE.md",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.app.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\"",
    "package:ui8": "bash scripts/package-ui8.sh"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.119.0",
    "clsx": "^2.1.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5"
  },
  "engines": {
    "node": ">=22.22.0"
  },
  "keywords": [
    "react",
    "typescript",
    "tailwindcss",
    "vite",
    "dashboard",
    "admin",
    "ai",
    "agents",
    "template",
    "dark-mode"
  ],
  "overrides": {
    "minimatch": "^11.0.3"
  }
}
