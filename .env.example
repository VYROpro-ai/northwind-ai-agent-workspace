# Northwind AI Agent Workspace — local environment (copy to .env)
# Firebase project 'northwind' — values from the Firebase Console once the
# project is created (the project id in .firebaserc is still a placeholder).
VITE_FIREBASE_API_KEY=your-api-key-here
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=your-app-id

# Chat Cloud Function (2nd gen, region asia-southeast1). Replace
# <project-id> with the real Firebase project id after it is created.
VITE_FIREBASE_CHAT_URL=https://asia-southeast1-<project-id>.cloudfunctions.net/chat

# GEMINI_API_KEY is NOT set here. It is a Cloud Functions secret:
#   firebase functions:secrets:set GEMINI_API_KEY
# Never put it in this file or in the frontend bundle.
