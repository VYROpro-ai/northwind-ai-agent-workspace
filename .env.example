# Northwind AI Agent Workspace — local environment (copy to .env)
# Supabase project 'northwind' — URL + anon key from the Supabase Dashboard.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# GEMINI_API_KEY is NOT set here. It is a Supabase Edge Function secret:
#   supabase secrets set GEMINI_API_KEY=<key>
# Never put it in this file or in the frontend bundle.
